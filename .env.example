# Copiar para ".env" (não versionado) e preencher.

# RunPod — pod (Community Cloud) ligado por sessão de lote, ver runpod/README.md
RUNPOD_API_KEY=
# Imagem publicada por: docker build+push a partir de runpod/Dockerfile
RUNPOD_IMAGE=

# Opcionais (têm omissão sensata em pipeline/runpod_pod_client.py):
# RUNPOD_CLOUD_TYPE=COMMUNITY
# RUNPOD_GPU_TYPE_IDS=NVIDIA RTX A4000,NVIDIA RTX A5000,NVIDIA GeForce RTX 4090
# RUNPOD_CONTAINER_DISK_GB=40

# Anthropic — usado por pipeline/edit_pipeline.py para interpretar as
# instruções de texto ("adicionar buraco de chaveiro 50mm") em operações CAD
ANTHROPIC_API_KEY=
